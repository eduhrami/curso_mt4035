    "typecheck": "tsc --noEmit",
    "diag": "vitest run --config vitest.diag.config.ts",
    "autoplay": "tsx autoplay/cli.ts autoplay",
    "replay": "tsx autoplay/cli.ts replay",
    "aggregate": "tsx autoplay/cli.ts aggregate",
